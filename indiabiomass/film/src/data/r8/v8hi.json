 "lines": [
  {
   "i": 0,
   "t": "Ask anyone in the biomass trade how they find a buyer.",
   "s": 10,
   "e": 118
  },
  {
   "i": 1,
   "t": "A phone call. A friend of a friend. A WhatsApp group with a thousand unread messages.",
   "s": 137,
   "e": 321
  },
  {
   "i": 2,
   "t": "Ask them how they know the right price.",
   "s": 338,
   "e": 413
  },
  {
   "i": 3,
   "t": "Most will tell you they don't. They find out after the deal.",
   "s": 431,
   "e": 559
  },
  {
   "i": 4,
   "t": "Meanwhile, power plants need fuel every day. Factories are switching their boilers. Farmers have straw with nowhere to go.",
   "s": 576,
   "e": 832
  },
  {
   "i": 5,
   "t": "The demand is real. The supply is real. What is missing is the link between them.",
   "s": 848,
   "e": 996
  },
  {
   "i": 6,
   "t": "So we are building it.",
   "s": 1011,
   "e": 1056
  },
  {
   "i": 7,
   "t": "Verified suppliers and buyers, in one place.",
   "s": 1068,
   "e": 1160
  },
  {
   "i": 8,
   "t": "Tenders, as they are published.",
   "s": 1172,
   "e": 1221
  },
  {
   "i": 9,
   "t": "Prices, region by region.",
   "s": 1235,
   "e": 1294
  },
  {
   "i": 10,
   "t": "Supply and policy updates, tracked for you.",
   "s": 1306,
   "e": 1406
  },
  {
   "i": 11,
   "t": "IndiaBiomass. The information and trust layer for India's biomass industry.",
   "s": 1419,
   "e": 1575
  }
 ],
