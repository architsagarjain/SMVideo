 "lines": [
  {
   "i": 0,
   "t": "Before a buyer pays for your biomass, they check five things. Know them before you quote.",
   "s": 9,
   "e": 154
  },
  {
   "i": 1,
   "t": "One. Moisture. Wet fuel burns poorly, and you end up transporting water. Most buyers set a maximum.",
   "s": 154,
   "e": 416
  },
  {
   "i": 2,
   "t": "Two. G-C-V. The heat your fuel gives per kilo. Below the minimum, the load can be rejected, or the price cut.",
   "s": 437,
   "e": 723
  },
  {
   "i": 3,
   "t": "Three. Ash. More ash means more cleaning, and more wear on the boiler.",
   "s": 746,
   "e": 909
  },
  {
   "i": 4,
   "t": "Four. Size. Pellets and briquettes must match the size the buyer's feeding system takes.",
   "s": 940,
   "e": 1116
  },
  {
   "i": 5,
   "t": "Five. Consistency. One good sample is not enough. Every truck has to match the spec.",
   "s": 1116,
   "e": 1313
  },
  {
   "i": 6,
   "t": "Get these five right, and price talks get a lot easier.",
   "s": 1329,
   "e": 1441
  },
  {
   "i": 7,
   "t": "Screenshot this before your next quote.",
   "s": 1462,
   "e": 1509
  },
  {
   "i": 8,
   "t": "IndiaBiomass. Connecting India's biomass economy.",
   "s": 1522,
   "e": 1637
  }
 ],
