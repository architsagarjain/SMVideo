 "lines": [
  {
   "i": 0,
   "t": "The rice is cut. The clock starts.",
   "s": 9,
   "e": 83
  },
  {
   "i": 1,
   "t": "In north India, farmers have only a few weeks between the paddy harvest and sowing wheat.",
   "s": 103,
   "e": 240
  },
  {
   "i": 2,
   "t": "The field has to be cleared. And the straw left behind is bulky, loose, and slow to move.",
   "s": 253,
   "e": 437
  },
  {
   "i": 3,
   "t": "Without a baler, a buyer, or a truck, the fastest option is a matchstick.",
   "s": 451,
   "e": 577
  },
  {
   "i": 4,
   "t": "That is why the smoke comes back every autumn.",
   "s": 587,
   "e": 674
  },
  {
   "i": 5,
   "t": "Now, the same straw, with a plan.",
   "s": 716,
   "e": 801
  },
  {
   "i": 6,
   "t": "The harvest ends. A baler arrives and packs the straw. Within days, an aggregator picks it up. The field is clear in time for wheat.",
   "s": 815,
   "e": 1075
  },
  {
   "i": 7,
   "t": "The straw becomes pellets. The pellets go to a plant that needs them.",
   "s": 1088,
   "e": 1220
  },
  {
   "i": 8,
   "t": "Same field. Same few weeks. A different ending.",
   "s": 1238,
   "e": 1351
  },
  {
   "i": 9,
   "t": "What decides it is whether the farmer can find a baler and a buyer in time.",
   "s": 1367,
   "e": 1511
  },
  {
   "i": 10,
   "t": "IndiaBiomass is building that connection.",
   "s": 1533,
   "e": 1596
  }
 ],
