 "lines": [
  {
   "i": 0,
   "t": "India does not have one kind of biomass. It has a different one in almost every region.",
   "s": 10,
   "e": 140
  },
  {
   "i": 1,
   "t": "In Punjab and Haryana, it is paddy straw, left behind after the rice harvest.",
   "s": 175,
   "e": 339
  },
  {
   "i": 2,
   "t": "In Rajasthan, mustard husk.",
   "s": 364,
   "e": 426
  },
  {
   "i": 3,
   "t": "Across Gujarat and Maharashtra, cotton stalks and groundnut shells.",
   "s": 448,
   "e": 572
  },
  {
   "i": 4,
   "t": "In Uttar Pradesh and Maharashtra, bagasse from the sugar mills.",
   "s": 595,
   "e": 734
  },
  {
   "i": 5,
   "t": "In the South, coconut shells. And rice husk, wherever rice is milled.",
   "s": 754,
   "e": 933
  },
  {
   "i": 6,
   "t": "Every one of these is a fuel, if it reaches the right buyer.",
   "s": 949,
   "e": 1048
  },
  {
   "i": 7,
   "t": "The problem is distance. The straw is in one state, the factory that needs it is in another, and neither knows the other exists.",
   "s": 1069,
   "e": 1375
  },
  {
   "i": 8,
   "t": "IndiaBiomass is mapping who has what, and where, so supply and demand can finally find each other.",
   "s": 1402,
   "e": 1644
  },
  {
   "i": 9,
   "t": "Which one grows near you?",
   "s": 1655,
   "e": 1722
  }
 ],
