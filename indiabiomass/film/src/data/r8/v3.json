 "lines": [
  {
   "i": 0,
   "t": "Pellet or briquette. Both are pressed biomass, but they are not the same product.",
   "s": 9,
   "e": 179
  },
  {
   "i": 1,
   "t": "Pellets are small, about the size of a pencil stub. They flow easily and feed automatically, which is why power plants co-firing biomass mostly ask for pellets.",
   "s": 200,
   "e": 508
  },
  {
   "i": 2,
   "t": "Briquettes are bigger, like short logs. They are popular with industrial boilers, brick kilns and factories.",
   "s": 528,
   "e": 692
  },
  {
   "i": 3,
   "t": "Pellets need finer, drier raw material and more processing, so a pellet plant costs more to set up.",
   "s": 711,
   "e": 902
  },
  {
   "i": 4,
   "t": "Briquette machines are simpler, which makes them an easier place to start.",
   "s": 920,
   "e": 1054
  },
  {
   "i": 5,
   "t": "So which one should you make?",
   "s": 1067,
   "e": 1112
  },
  {
   "i": 6,
   "t": "It depends on two things. The raw material you have, and who is buying near you.",
   "s": 1131,
   "e": 1279
  },
  {
   "i": 7,
   "t": "Pellet makers, briquette makers, and the buyers for both. IndiaBiomass is bringing them together.",
   "s": 1291,
   "e": 1481
  }
 ],
