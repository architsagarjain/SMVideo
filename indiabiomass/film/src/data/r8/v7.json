 "lines": [
  {
   "i": 0,
   "t": "Four close-ups. Guess what each one is. The answer comes after each.",
   "s": 9,
   "e": 173
  },
  {
   "i": 1,
   "t": "Number one. Fine, golden and light. It comes off the grain at a rice mill.",
   "s": 200,
   "e": 382
  },
  {
   "i": 2,
   "t": "Rice husk. A common boiler fuel, because it is dry and already collected in one place.",
   "s": 459,
   "e": 611
  },
  {
   "i": 3,
   "t": "Number two. Pale and fibrous. It is what is left after the juice is pressed out of sugarcane.",
   "s": 632,
   "e": 875
  },
  {
   "i": 4,
   "t": "Bagasse. Many sugar mills burn it to power themselves.",
   "s": 875,
   "e": 992
  },
  {
   "i": 5,
   "t": "Number three. Light, papery pieces, left after threshing a winter oilseed.",
   "s": 1011,
   "e": 1180
  },
  {
   "i": 6,
   "t": "Mustard husk. Common across Rajasthan.",
   "s": 1244,
   "e": 1324
  },
  {
   "i": 7,
   "t": "Number four. Hard, curved and brown. Mostly from the South.",
   "s": 1367,
   "e": 1476
  },
  {
   "i": 8,
   "t": "Coconut shell. Dense, and also made into charcoal.",
   "s": 1541,
   "e": 1639
  },
  {
   "i": 9,
   "t": "How many did you get? Tell us in the comments.",
   "s": 1658,
   "e": 1723
  },
  {
   "i": 10,
   "t": "Every one of these has a buyer somewhere. IndiaBiomass is building the way to find them.",
   "s": 1748,
   "e": 1891
  }
 ],
