 "lines": [
  {
   "i": 0,
   "t": "Four things people get wrong about the biomass business.",
   "s": 9,
   "e": 109
  },
  {
   "i": 1,
   "t": "Myth one. Biomass is just waste.",
   "s": 129,
   "e": 205
  },
  {
   "i": 2,
   "t": "Fact. Once it is collected, dried and processed, it is a fuel, with a spec sheet, a price, and buyers waiting for it.",
   "s": 226,
   "e": 470
  },
  {
   "i": 3,
   "t": "Myth two. Only big companies can sell to power plants.",
   "s": 484,
   "e": 589
  },
  {
   "i": 4,
   "t": "Fact. Many tenders are open to smaller suppliers, and registered M-S-Es can often skip the deposit.",
   "s": 607,
   "e": 854
  },
  {
   "i": 5,
   "t": "Myth three. All straw is the same.",
   "s": 873,
   "e": 954
  },
  {
   "i": 6,
   "t": "Fact. Moisture, ash and heat value decide what your fuel is worth. Buyers test every load.",
   "s": 997,
   "e": 1212
  },
  {
   "i": 7,
   "t": "Myth four. The price is whatever the buyer says.",
   "s": 1223,
   "e": 1299
  },
  {
   "i": 8,
   "t": "Fact. Prices change by region and by season. The real problem is that most sellers cannot see them.",
   "s": 1311,
   "e": 1521
  },
  {
   "i": 9,
   "t": "IndiaBiomass is building one place to see suppliers, tenders and prices across India.",
   "s": 1538,
   "e": 1688
  }
 ],
