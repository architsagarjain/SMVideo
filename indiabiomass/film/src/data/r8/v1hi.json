 "lines": [
  {
   "i": 0,
   "t": "This is a bale of paddy straw. A month ago, it was standing in a field in Punjab. Here is where it goes next.",
   "s": 10,
   "e": 242
  },
  {
   "i": 1,
   "t": "After the harvest, a baler presses the loose straw into tight bales, so it can be moved instead of burned.",
   "s": 259,
   "e": 517
  },
  {
   "i": 2,
   "t": "An aggregator collects bales from dozens of farms and stacks them at a depot, dry and covered.",
   "s": 558,
   "e": 756
  },
  {
   "i": 3,
   "t": "From there, a truck takes them to a pellet plant. The straw is shredded, dried, and pressed into small, dense pellets.",
   "s": 784,
   "e": 1022
  },
  {
   "i": 4,
   "t": "The pellets are tested. Heat value. Moisture. Ash. Then they are loaded for a power plant that must burn biomass along with coal.",
   "s": 1071,
   "e": 1416
  },
  {
   "i": 5,
   "t": "One bale. Five businesses. Farmer, baler, aggregator, pellet maker, buyer.",
   "s": 1433,
   "e": 1610
  },
  {
   "i": 6,
   "t": "Every link has to find the next one.",
   "s": 1624,
   "e": 1688
  },
  {
   "i": 7,
   "t": "That is the chain IndiaBiomass is being built to connect.",
   "s": 1702,
   "e": 1827
  }
 ],
