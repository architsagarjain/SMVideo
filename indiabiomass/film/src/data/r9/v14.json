 "lines": [
  {
   "i": 0,
   "t": "Seven a.m. Two people, two districts apart.",
   "s": 9,
   "e": 103
  },
  {
   "i": 1,
   "t": "In Punjab, a pellet maker has a warehouse full of stock, and no one to sell to.",
   "s": 110,
   "e": 258
  },
  {
   "i": 2,
   "t": "In Haryana, a factory manager needs fuel by Friday, and no one to buy from.",
   "s": 267,
   "e": 405
  },
  {
   "i": 3,
   "t": "She calls three traders. He checks old WhatsApp groups.",
   "s": 419,
   "e": 512
  },
  {
   "i": 4,
   "t": "She hears three different prices. He gets no reply.",
   "s": 529,
   "e": 618
  },
  {
   "i": 5,
   "t": "By evening, his boiler runs short. Her stock is still waiting.",
   "s": 632,
   "e": 751
  },
  {
   "i": 6,
   "t": "They just never found each other.",
   "s": 802,
   "e": 831
  },
  {
   "i": 7,
   "t": "That is the real gap in India's biomass trade. Not supply. Not demand. The connection.",
   "s": 825,
   "e": 967
  },
  {
   "i": 8,
   "t": "IndiaBiomass is building it.",
   "s": 988,
   "e": 1055
  }
 ],
