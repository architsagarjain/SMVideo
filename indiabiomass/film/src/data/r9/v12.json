 "lines": [
  {
   "i": 0,
   "t": "Biomass has seasons, just like crops.",
   "s": 14,
   "e": 95
  },
  {
   "i": 1,
   "t": "October and November. The paddy harvest in the north. Paddy straw everywhere, and little time.",
   "s": 117,
   "e": 324
  },
  {
   "i": 2,
   "t": "From November, sugar mills start crushing. Bagasse piles up until spring.",
   "s": 341,
   "e": 489
  },
  {
   "i": 3,
   "t": "Through winter, cotton stalks are cleared from the fields.",
   "s": 506,
   "e": 597
  },
  {
   "i": 4,
   "t": "February to April. Mustard husk, then wheat straw.",
   "s": 626,
   "e": 723
  },
  {
   "i": 5,
   "t": "And rice husk comes all year, wherever rice mills run.",
   "s": 740,
   "e": 840
  },
  {
   "i": 6,
   "t": "Buy in season, and supply is easy. Buy out of season, and you compete for what is left.",
   "s": 840,
   "e": 1042
  },
  {
   "i": 7,
   "t": "Plan your year around the calendar.",
   "s": 1056,
   "e": 1106
  },
  {
   "i": 8,
   "t": "IndiaBiomass will help you see what is available, and where.",
   "s": 1126,
   "e": 1227
  }
 ],
