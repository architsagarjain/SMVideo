 "lines": [
  {
   "i": 0,
   "t": "Four red flags in any biomass deal.",
   "s": 9,
   "e": 82
  },
  {
   "i": 1,
   "t": "One. No specs in writing. If moisture, ash and heat value are not written down, every dispute is your word against theirs.",
   "s": 96,
   "e": 387
  },
  {
   "i": 2,
   "t": "Two. A price far below everyone else. Very cheap fuel often means wet, mixed, or not there at all.",
   "s": 404,
   "e": 638
  },
  {
   "i": 3,
   "t": "Three. Full payment in advance, to someone you have never verified.",
   "s": 650,
   "e": 793
  },
  {
   "i": 4,
   "t": "Four. No delivery schedule. Without dates and quantities, a deal is just a conversation.",
   "s": 793,
   "e": 1023
  },
  {
   "i": 5,
   "t": "One red flag means ask more questions. Two means walk away.",
   "s": 1045,
   "e": 1202
  },
  {
   "i": 6,
   "t": "Trade with people you can verify.",
   "s": 1219,
   "e": 1262
  },
  {
   "i": 7,
   "t": "That is what IndiaBiomass is being built for.",
   "s": 1262,
   "e": 1334
  }
 ],
