 "lines": [
  {
   "i": 0,
   "t": "One word you will hear more often in biomass. Torrefaction.",
   "s": 9,
   "e": 149
  },
  {
   "i": 1,
   "t": "It means roasting biomass at a high temperature, with very little oxygen. Not burning it. Roasting it.",
   "s": 166,
   "e": 426
  },
  {
   "i": 2,
   "t": "What comes out is dark, dry and brittle. Almost like coal.",
   "s": 437,
   "e": 545
  },
  {
   "i": 3,
   "t": "Why does that matter?",
   "s": 563,
   "e": 589
  },
  {
   "i": 4,
   "t": "It packs more heat into every kilo.",
   "s": 608,
   "e": 682
  },
  {
   "i": 5,
   "t": "It does not soak up water, so it stores better.",
   "s": 691,
   "e": 775
  },
  {
   "i": 6,
   "t": "And it grinds easily, which power plants like, because their mills are built for coal.",
   "s": 775,
   "e": 946
  },
  {
   "i": 7,
   "t": "Torrefaction plants, pellet makers and buyers. IndiaBiomass is bringing them together.",
   "s": 976,
   "e": 1138
  }
 ],
