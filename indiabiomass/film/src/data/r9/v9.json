 "lines": [
  {
   "i": 0,
   "t": "Loose straw goes in. Hard pellets come out. Here is what happens in between.",
   "s": 9,
   "e": 162
  },
  {
   "i": 1,
   "t": "Step one. Cleaning. Stones and metal are removed.",
   "s": 192,
   "e": 302
  },
  {
   "i": 2,
   "t": "Step two. Drying. Pellets need low moisture to hold together.",
   "s": 312,
   "e": 413
  },
  {
   "i": 3,
   "t": "Step three. Grinding. A hammer mill turns the straw into powder.",
   "s": 427,
   "e": 537
  },
  {
   "i": 4,
   "t": "Step four. Pressing. Rollers force it through a steel die. Heat and pressure make it bind.",
   "s": 554,
   "e": 712
  },
  {
   "i": 5,
   "t": "Step five. Cooling. Hot, soft pellets turn hard.",
   "s": 728,
   "e": 835
  },
  {
   "i": 6,
   "t": "Step six. Screening and bagging, ready for the buyer.",
   "s": 835,
   "e": 965
  },
  {
   "i": 7,
   "t": "Six steps, and a waste becomes a fuel.",
   "s": 985,
   "e": 1066
  },
  {
   "i": 8,
   "t": "Pellet makers, machinery suppliers and buyers. IndiaBiomass is bringing them together.",
   "s": 1086,
   "e": 1253
  }
 ],
