 "lines": [
  {
   "i": 0,
   "t": "Five things you probably did not know about biomass.",
   "s": 9,
   "e": 94
  },
  {
   "i": 1,
   "t": "One. Many sugar mills run on their own waste, burning bagasse for steam and power.",
   "s": 121,
   "e": 277
  },
  {
   "i": 2,
   "t": "Two. Rice husk ash goes into cement and steel making.",
   "s": 287,
   "e": 414
  },
  {
   "i": 3,
   "t": "Three. Coconut shells become activated carbon, used in water filters.",
   "s": 428,
   "e": 568
  },
  {
   "i": 4,
   "t": "Four. Paddy straw can be turned into compressed biogas. C-B-G plants already run on it.",
   "s": 581,
   "e": 797
  },
  {
   "i": 5,
   "t": "Five. In the hills, fallen pine needles are pressed into briquettes.",
   "s": 814,
   "e": 934
  },
  {
   "i": 6,
   "t": "The same residue can go a dozen ways.",
   "s": 951,
   "e": 1008
  },
  {
   "i": 7,
   "t": "The question is who needs it, and where.",
   "s": 1014,
   "e": 1093
  },
  {
   "i": 8,
   "t": "IndiaBiomass is building the way to find out.",
   "s": 1108,
   "e": 1191
  }
 ],
